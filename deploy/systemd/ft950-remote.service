[Unit]
Description=FT-950 Remote (CAT control, FT8/FT4 decoding, web UI)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=/opt/ft950-remote/backend
# HTTPS: certs/ is issued by deploy/gen-server-cert.sh from the private root CA
# (shared with TM-V71 Remote). Port 8444 so both projects can run side by side.
ExecStart=/opt/ft950-remote/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8444 --ssl-keyfile certs/key.pem --ssl-certfile certs/cert.pem
# /run/ft950 = tmpfs for the 12 kHz decoder slices (settings.digi_work_dir)
RuntimeDirectory=ft950
# /var/lib/ft950 = jt9 data (FFTW wisdom), kept across restarts
StateDirectory=ft950
# "always": a radio that answers nothing because its backend died is the one
# state this must not stay in (TM-V71 Remote lesson).
Restart=always
RestartSec=3
# Stop: SIGTERM to the backend only, so its shutdown runs first (PTT off, tone
# faded, jt9/arecord ended in order); whatever is left is killed afterwards.
KillMode=mixed
TimeoutStopSec=10
# Measured with cgroup accounting: ~110 MB steady, 200 MB peak including the
# jt9 runs. The caps only act with the memory cgroup controller: Raspberry Pi
# OS boots with cgroup_disable=memory; append
# "cgroup_enable=memory cgroup_memory=1" to /boot/firmware/cmdline.txt
# (done on .156 on 2026-10-24).
MemoryHigh=500M
MemoryMax=700M
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
